?start: expr

expr: term (OR term)*

term: factor (AND factor)*

factor: NOT? atom

?atom: "(" expr ")"
    | identifier operator value -> comparison
    | identifier -> test

identifier: LITERAL | "options" LBRACKET value RBRACKET
?operator: EQ  | NEQ | LT | LTE | GT | GTE | CONTAINS | NOTCONTAINS
                | STARTSWITH | ENDSWIDTH | IS
?value: LITERAL | STRING | UUID | DATETIME | DURATION | SIGNED_NUMBER

// Boolean operators
OR: "or" | "OR" | "|" | "||"
AND: "and" | "AND" | "&" | "&&"
NOT: "not" | "NOT" | "!" | "~"

// Comparison operators
EQ: "=" | "=="
NEQ: "!="
LT: "<"
LTE: "<="
GT: ">"
GTE: ">="
CONTAINS: "contains" | "~"
NOTCONTAINS: "notcontains" | "!~"
STARTSWITH: "startswith"
ENDSWIDTH: "endswith"
IS: "is" | "IS"

// Terminals types
LITERAL: /[a-zA-Z_][a-zA-Z0-9-_\.]*/
STRING: /(".*?(?<!\\)(\\\\)*?"|'.*?(?<!\\)(\\\\)*?')/i
// Unquoted object IDs (UUIDs, with an optional "###N" retry suffix), which LITERAL rejects.
// The exact shape avoids ambiguity with DATETIME (e.g. 2024-01-01).
UUID: /[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?:###\d+)?/
DATETIME: /\d{4}-\d{2}-\d{2}(?:T\d{1,2}:\d{2}:\d{2}(?:\.\d+)?)?/
DURATION: /-?(?:\d+\.)?\d{1,2}:\d{2}:\d{2}(?:\.\d+)?/
LBRACKET: "["
RBRACKET: "]"

%import common.SIGNED_NUMBER
%import common.WS

%ignore WS
